# Salin file ini ke .env.local untuk development lokal
# Di Netlify: isi di dashboard → Site Settings → Environment Variables

# ── AI via Cloudflare Workers AI ───────────────────────────────────
# Dashboard Cloudflare → AI → Workers AI. Account ID ada di sidebar URL.
# API Token: My Profile → API Tokens → buat token dengan izin "Workers AI".
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxx

# ── Pembayaran Midtrans ────────────────────────────────────────────
# Server Key Midtrans (JANGAN commit key asli ke git)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxxx

# Set ke "true" saat production (pakai key production Midtrans)
MIDTRANS_IS_PRODUCTION=false

# ── Kode Aktivasi Pro (owner/gift/tester) ──────────────────────────
# Kode rahasia divalidasi di backend (tidak ada di frontend).
# Pisah dengan koma untuk beberapa kode.
KODE_AKTIVASI=KPR-OWNER-XXX,KPR-GIFT-XXX,KPR-TESTER-XXX
